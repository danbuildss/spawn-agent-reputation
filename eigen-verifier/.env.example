# Environment variables for Spawn TEE Verifier
# Variables ending with _PUBLIC will be visible on-chain
# All other variables will be encrypted

# Auto-provided by TEE KMS
# MNEMONIC=<auto-injected>

# Server port
APP_PORT=3001

# BaseScan API key (for getting contract creator)
# Get one at: https://basescan.org/myapikey
BASESCAN_API_KEY=your_basescan_api_key

# Public info
VERSION_PUBLIC=2.0.0
CHAIN_PUBLIC=base
